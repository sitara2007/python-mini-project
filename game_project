def play(user_choice):
    comp = random.choice(["stone", "paper", "scissors"])

    if user_choice == comp:
        return "Draw"

    elif (user_choice == "stone" and comp == "scissors") or \
         (user_choice == "paper" and comp == "stone") or \
         (user_choice == "scissors" and comp == "paper"):
        return "You Win"

    else:
        return "Computer Wins"
import random

def roll_dice():
    user = random.randint(1, 6)
    comp = random.randint(1, 6)

    if user > comp:
        return "You Win"
    elif user < comp:
        return "Computer Wins"
    else:
        return "Draw"
